{
  "name": "metro-quiz",
  "private": true,
  "version": "0.5.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:lines": "node scripts/check-lines.mjs",
    "check": "tsc -b --noEmit && node scripts/check-lines.mjs && node scripts/check-money.ts && node scripts/check-drawing.mjs && node scripts/check-tiers.ts",
    "check:money": "node scripts/check-money.ts",
    "check:drawing": "node scripts/check-drawing.mjs",
    "check:tiers": "node scripts/check-tiers.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
